{
  "diff_view_style": "split",
  "cli_default_open_behavior": "new_window",
  "agent_servers": {
    "claude-acp": {
      "default_config_options": {
        "mode": "bypassPermissions",
      },
      "type": "registry",
    },
    "codex-acp": {
      "type": "registry",
    },
  },
  "collaboration_panel": {
    "dock": "left",
  },
  "git_panel": {
    "dock": "left",
  },
  "session": {
    "trust_all_worktrees": true,
  },
  "icon_theme": {
    "mode": "light",
    "light": "Catppuccin Macchiato",
    "dark": "Warm Charmed Icons",
  },
  "theme": {
    "mode": "dark",
    "light": "Ayu Light",
    "dark": "Catppuccin Macchiato",
  },
  "title_bar": {
    "show_onboarding_banner": false,
    "show_project_items": true,
    "show_branch_name": true,
    "show_user_menu": false,
  },
  "tab_bar": {
    "show": true,
    "show_tab_bar_buttons": false,
  },
  "toolbar": {
    "quick_actions": false,
  },
  "status_bar": {
    "experimental.show": false,
  },
  "show_wrap_guides": false,
  "relative_line_numbers": "disabled",
  "excerpt_context_lines": 4,
  "expand_excerpt_lines": 6,
  "agent": {
    "dock": "left",
    "default_model": {
      "provider": "anthropic",
      "model": "claude-opus-4-6-latest",
      "enable_thinking": false,
    },
    "play_sound_when_agent_done": "always",
    "enable_feedback": false,
  },
  "project_panel": {
    "button": true,
    "dock": "left",
    "default_width": 400,
    "hide_root": true,
    "auto_fold_dirs": false,
    "starts_open": true,
    "git_status": false,
    "sticky_scroll": false,
    "scrollbar": {
      "show": "never",
    },
    "entry_spacing": "comfortable",
    "indent_size": 15.0,
    "indent_guides": {
      "show": "never",
    },
  },
  "outline_panel": {
    "dock": "right",
  },
  "file_finder": {
    "modal_max_width": "large",
  },
  "scrollbar": {
    "show": "never",
  },
  "git": {
    "blame": {
      "show_avatar": false,
    },
    "inline_blame": {
      "min_column": 80,
      "padding": 30,
      "show_commit_summary": false,
      "delay_ms": 0,
    },
  },
  "gutter": {
    "min_line_number_digits": 0,
    "folds": false,
    "runnables": false,
    "line_numbers": true,
  },
  "autosave": "on_focus_change",
  "buffer_line_height": "comfortable",
  "buffer_font_weight": 400.0,
  "buffer_font_family": "Cascadia Code NF",
  "ui_font_family": "Cascadia Code NF",
  "ui_font_size": 15.0,
  "buffer_font_size": 14.0,
  "agent_ui_font_size": 16.0,
  "indent_guides": {
    "enabled": false,
  },
  "double_click_in_multibuffer": "open",
  "unnecessary_code_fade": 0.1,
  "vim_mode": true,
  "drag_and_drop_selection": {
    "enabled": false,
  },
  "show_whitespaces": "none",
  "tab_size": 2,
  "multi_cursor_modifier": "cmd_or_ctrl",
  "languages": {
    "Markdown": {
      "preferred_line_length": 90,
    },
    "Elixir": {
      "language_servers": ["expert", "!elixir-ls", "!next-ls", "!lexical"],
      // "language_servers": ["elixir-ls", "!expert", "!next-ls", "!lexical"],
    },
  },
}
